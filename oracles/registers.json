{
  "spec": "uor-community/registers/1",
  "about": "Every projected register, the pinned sources it reads and the commands that re-project it with --check. oracles/reproject.mjs runs one entry; the oracles workflow runs each entry whose inputs changed. `inputs` are the globs the entry's cache key hashes; `tools` are the commands whose output names a tool version the projection depends on. In a command, {sources} is the directory the pinned sources were fetched into.",
  "registers": [
    {
      "area": "chaoss",
      "sources": { "kind": "git-commits", "file": "chaoss/sources.json", "base": "https://github.com/chaoss/" },
      "inputs": ["chaoss/**"],
      "tools": [],
      "check": [
        ["node", "chaoss/project.mjs", "{sources}", "--check"],
        ["node", "chaoss/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "remediation",
      "sources": { "kind": "git-urls", "file": "remediation/sources.json" },
      "inputs": ["remediation/**", "ecosystem/register.json", "ecosystem/snapshot.json"],
      "tools": [],
      "check": [
        ["node", "remediation/project.mjs", "{sources}", "--check"],
        ["node", "remediation/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "observations",
      "sources": { "kind": "committed", "file": "observations/corpus.json" },
      "inputs": ["observations/**", "chaoss/register.json", "chaoss/oracle-methods.json", "apps/uor-observation-admission.prompt.json", "apps/uor-contribution-attribution.prompt.json", "governance/agents.json"],
      "tools": [],
      "check": [
        ["node", "observations/project.mjs", "--check"],
        ["node", "observations/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "interventions",
      "sources": { "kind": "committed", "file": "observations/corpus.json" },
      "inputs": ["interventions/**", "observations/**", "chaoss/register.json", "chaoss/oracle-methods.json", "apps/uor-observation-admission.prompt.json", "apps/uor-contribution-attribution.prompt.json", "governance/agents.json", "automation/intervention-*.json", "automation/intervention-*.prompt.json", "automation/interventions.json"],
      "tools": [],
      "check": [
        ["node", "interventions/project.mjs", "--check"]
      ]
    },
    {
      "area": "chaoss-oracle",
      "sources": { "kind": "git-commits", "file": ["chaoss/sources.json", "chaoss/oracle-sources.json", "chaoss/upstream-sources.json"], "base": "https://github.com/chaoss/" },
      "inputs": ["chaoss/**", "upstream/chaoss-15939/**", "oracles/grimoirelab/perceval-discord/perceval/backends/core/discord.py"],
      "tools": [],
      "check": [
        ["node", "chaoss/oracle.mjs", "{sources}", "--check"],
        ["node", "chaoss/measurement.mjs", "--check"],
        ["node", "chaoss/upstream.mjs", "{sources}", "--check"]
      ]
    },
    {
      "area": "nonprofit",
      "sources": {"kind": "git-urls", "file": "nonprofit/sources.json"},
      "inputs": ["nonprofit/**", "governance/register.json", "apps/uor-990-return.prompt.json", "tools/register-lex.mjs"],
      "tools": [["pdftotext", "-v"]],
      "check": [
        ["node", "nonprofit/project.mjs", "{sources}", "--check"],
        ["node", "nonprofit/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "inventory",
      "sources": {"kind": "git-urls", "file": "inventory/sources.json"},
      "inputs": ["inventory/**", "ecosystem/register.json", "governance/discord.json", "observations/responses/discord/guild.json", "tools/register-lex.mjs"],
      "tools": [],
      "check": [
        ["node", "inventory/project.mjs", "{sources}", "--check"],
        ["node", "inventory/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "supply",
      "sources": {"kind": "git-urls", "file": ["supply/snapshot.json", "supply/sources.json"]},
      "inputs": ["supply/**", "ecosystem/snapshot.json", "tools/register-lex.mjs", "package-lock.json"],
      "tools": [],
      "check": [
        ["node", "supply/project.mjs", "{sources}", "--check"],
        ["node", "supply/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "reorg",
      "sources": {"kind": "git-urls", "file": "reorg/sources.json"},
      "inputs": ["reorg/**", "ecosystem/snapshot.json", "apps/uor-repo-disposition.prompt.json", "apps/set.json", "tools/register-lex.mjs"],
      "tools": [],
      "check": [
        ["node", "reorg/project.mjs", "{sources}", "--check"],
        ["node", "reorg/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "licensing",
      "sources": {"kind": "git-urls", "file": "licensing/sources.json"},
      "inputs": ["licensing/**", "ecosystem/snapshot.json", "tools/register-lex.mjs"],
      "tools": [["reuse", "--version"]],
      "check": [
        ["node", "licensing/scan.mjs", "{sources}", "--prune", "--check"],
        ["node", "licensing/project.mjs", "{sources}", "--check"],
        ["node", "licensing/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "policies",
      "sources": {"kind": "git-urls", "file": "policies/sources.json"},
      "inputs": ["policies/**", "governance/register.json", "nonprofit/register.json", "nonprofit/snapshot.json", "tools/register-lex.mjs"],
      "tools": [["pdftotext", "-v"], ["pdftohtml", "-v"]],
      "check": [
        ["node", "policies/project.mjs", "{sources}", "--check"],
        ["node", "policies/catalog.mjs", "--check"]
      ]
    },
    {
      "area": "standards",
      "sources": {"kind": "committed", "file": "standards/snapshot.json"},
      "inputs": ["standards/**", "apps/uor-standard-applicability.prompt.json", "standards.lock", "*/register.json", "*/sources.json", "tools/register-lex.mjs"],
      "tools": [],
      "check": [
        ["node", "standards/project.mjs", "--check"],
        ["node", "standards/catalog.mjs", "--check"]
      ]
    }
  ]
}
